# Copier ce fichier en .env.local et renseigner vos propres valeurs.
# Ne jamais committer le fichier .env.local (déjà exclu via .gitignore).
#
# Vite n'expose au bundle client que les variables préfixées VITE_ — ne
# jamais y placer de secret serveur (ex. ORS_API_KEY, qui reste côté
# backend derrière RoutingProvider).

# URL de base de l'API backend SafeWayRoad
VITE_API_BASE_URL=http://localhost:3000

# Clé MapTiler (tuiles de carte) — dashboard MapTiler → Keys
VITE_MAPTILER_API_KEY=

# Google Auth api key
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com